---
import type { VocabItem } from '../types';
interface Props { items: VocabItem[]; }
const { items } = Astro.props;
const words = items.filter(i => i.type === 'word');
const serialized = JSON.stringify(words);
const temas = [...new Set(words.flatMap(i => i.tags ?? []))].sort();
---

<div id="pc-root" class="w-full flex flex-col gap-3">

  <!-- ── MOBILE: settings toggle ── -->
  <div class="lg:hidden flex justify-end">
    <button id="pc-settings-toggle"
      class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium border border-white/10 text-slate-300 hover:bg-white/5 transition-colors">
      ⚙️ <span>Ajustes</span>
    </button>
  </div>

  <!-- ── MOBILE: settings panel (slide-down) ── -->
  <div id="pc-settings-panel" class="lg:hidden overflow-hidden"
    style="max-height:0; transition:max-height 0.25s ease, opacity 0.2s ease; opacity:0">
    <div class="bg-white/5 border border-white/10 rounded-2xl p-4 mb-1 grid grid-cols-2 gap-4">

      <div class="flex flex-col gap-2">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Tema</span>
        <div class="relative">
          <select id="tema-mob"
            class="w-full px-3 py-2 pr-7 rounded-xl bg-slate-800 border border-slate-600 text-white text-sm outline-none focus:border-indigo-500 appearance-none cursor-pointer">
            <option value="all">Todos</option>
            {temas.map(t => <option value={t}>{t.replace('tema','Tema ')}</option>)}
          </select>
          <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs">▾</span>
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Dirección</span>
        <div class="flex flex-col gap-1">
          <button class="dir-btn active text-left" data-dir="random">🔀 Aleat.</button>
          <button class="dir-btn text-left" data-dir="zh-to-es">中 → ES</button>
          <button class="dir-btn text-left" data-dir="es-to-zh">ES → 中</button>
        </div>
      </div>

    </div>
  </div>

  <!-- ── 3-COLUMN GRID (desktop) / single col (mobile) ── -->
  <div class="lg:grid lg:grid-cols-[208px_1fr_208px] lg:gap-5 lg:items-start">

    <!-- Col 1: sidebar (desktop only) -->
    <aside class="hidden lg:flex flex-col gap-4">

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 flex flex-col gap-2">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Tema</span>
        <div class="relative">
          <select id="tema-desk"
            class="w-full px-3 py-2 pr-8 rounded-xl bg-slate-800 border border-slate-600 text-white text-sm outline-none focus:border-indigo-500 appearance-none cursor-pointer">
            <option value="all">Todos</option>
            {temas.map(t => <option value={t}>{t.replace('tema','Tema ')}</option>)}
          </select>
          <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs">▾</span>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 flex flex-col gap-2">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Dirección</span>
        <div class="flex flex-col gap-1.5">
          <button class="dir-btn active" data-dir="random">🔀 Aleatorio</button>
          <button class="dir-btn" data-dir="zh-to-es">中文 → Español</button>
          <button class="dir-btn" data-dir="es-to-zh">Español → 中 / Pīn</button>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 flex flex-col gap-3">
        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Progreso SRS</h3>
        <div id="srs-counts" class="flex flex-col gap-1.5 text-xs"></div>
      </div>

    </aside>

    <!-- Col 2: THE CARD — always centered -->
    <div class="flex flex-col items-center gap-3">

      <!-- Session progress bar -->
      <div id="session-progress" class="w-full max-w-[520px]">
        <div class="flex justify-between items-center mb-1.5 text-xs">
          <span class="text-slate-400"><span id="session-pos">0</span> / <span id="session-total">0</span></span>
          <span id="session-accuracy-text" class="font-semibold"></span>
        </div>
        <div class="h-1.5 bg-white/10 rounded-full overflow-hidden">
          <div id="session-bar" class="h-full bg-indigo-500 rounded-full transition-all duration-500" style="width:0%"></div>
        </div>
      </div>

      <div id="pc-card" class="w-full max-w-[520px] bg-white/5 border border-white/10 rounded-2xl p-6 flex flex-col gap-5">

        <div class="flex items-center gap-2 flex-wrap">
          <span id="type-badge" class="text-xs font-medium px-2 py-0.5 rounded-full bg-white/10 text-slate-300 border border-white/10"></span>
          <span id="srs-badge" class="text-xs font-medium px-2 py-0.5 rounded-full border"></span>
          <span id="extra-badge" class="hidden text-xs font-medium px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30">extra</span>
        </div>

        <div class="text-center py-8 min-h-[9rem] flex flex-col items-center justify-center gap-3">
          <span id="prompt-text"></span>
          <span id="prompt-hint" class="text-xs text-slate-400 tracking-wide uppercase"></span>
        </div>

        <div class="flex flex-col gap-1 text-center min-h-[3.25rem]">
          <p class="h-6"><span id="pinyin-text"  class="text-base italic text-indigo-300 invisible"></span></p>
          <p class="h-6"><span id="meaning-text" class="text-sm text-emerald-300 invisible"></span></p>
        </div>

        <input id="answer-input" type="text"
          autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false"
          placeholder="Escribe tu respuesta…"
          class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-600 text-white placeholder-slate-500 text-base outline-none focus:border-indigo-500 transition-colors"
        />

        <div id="result-banner" class="hidden rounded-xl px-4 py-3 text-sm text-center">
          <p id="result-line" class="font-semibold"></p>
          <p id="correct-answer" class="mt-0.5 text-slate-400"></p>
        </div>

        <div class="flex gap-2">
          <button id="btn-pinyin"  class="btn-reveal flex-1 py-2 rounded-xl text-sm font-medium border border-white/10 text-slate-300 hover:bg-white/5 transition-colors">Pinyin</button>
          <button id="btn-meaning" class="btn-reveal flex-1 py-2 rounded-xl text-sm font-medium border border-white/10 text-slate-300 hover:bg-white/5 transition-colors">Significado</button>
        </div>

        <div id="row-check">
          <button id="btn-check" class="w-full py-3 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors">
            Comprobar →
          </button>
        </div>

        <div id="row-next" class="hidden">
          <button id="btn-next" class="w-full py-3 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors">
            Siguiente →
          </button>
        </div>

        <div id="row-selfassess" class="hidden flex gap-2">
          <button id="btn-knew"  class="flex-1 py-3 rounded-xl text-sm font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors">✓ Lo sabía</button>
          <button id="btn-didnt" class="flex-1 py-3 rounded-xl text-sm font-semibold bg-rose-600 hover:bg-rose-500 text-white transition-colors">✗ No lo sabía</button>
        </div>

      </div>

      <!-- Session end screen -->
      <div id="session-end" class="hidden w-full max-w-[520px] bg-white/5 border border-white/10 rounded-2xl p-6 flex-col gap-5">
        <div class="text-center py-2">
          <div id="session-end-emoji" class="text-5xl mb-3">🎉</div>
          <h2 id="session-end-title" class="text-xl font-bold text-white">Sesión completada</h2>
          <p id="session-end-subtitle" class="text-slate-400 text-sm mt-1"></p>
        </div>
        <div id="session-stats" class="grid grid-cols-2 gap-3"></div>
        <div id="session-leveled" class="hidden flex-col gap-2">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wide">↑ Listas para subir de nivel</h3>
            <button id="btn-confirm-levelup" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-violet-600 hover:bg-violet-500 text-white transition-colors">↑ Subir nivel</button>
          </div>
          <div id="session-leveled-list" class="flex flex-wrap gap-1.5"></div>
        </div>
        <div id="session-errors-section" class="hidden flex-col gap-2">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wide">⚠ Para repasar</h3>
          <div id="session-errors-list" class="flex flex-wrap gap-1.5"></div>
        </div>
        <div class="flex flex-col gap-2">
          <button id="btn-retry-errors" class="hidden w-full py-3 rounded-xl text-sm font-semibold bg-rose-600 hover:bg-rose-500 text-white transition-colors">🔁 Repasar errores</button>
          <button id="btn-new-session" class="w-full py-3 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors">▶ Nueva sesión</button>
          <button id="btn-practice-all" class="w-full py-3 rounded-xl text-sm font-medium border border-white/10 text-slate-300 hover:bg-white/5 transition-colors">Practicar todas (sin SRS)</button>
        </div>
      </div>

    </div>

    <!-- Col 3: mirror spacer (desktop only) -->
    <div class="hidden lg:block"></div>

  </div>
</div>

<style>
  .dir-btn {
    @apply w-full px-3 py-1.5 rounded-lg text-xs font-medium border border-white/10 text-slate-400 hover:bg-white/5 transition-colors;
  }
  .dir-btn.active { @apply bg-indigo-600 text-white border-indigo-500; }
  .btn-reveal.on  { @apply bg-white/10 border-white/20 text-white; }
</style>

<script define:vars={{ serialized }}>
  const INTERVALS   = [0, 1, 3, 7, 14];
  const BOX_LABEL   = ['nueva','aprendiendo','revisando','consolidando','dominada'];
  const BOX_CLASSES = [
    'bg-slate-700/50 text-slate-300 border-slate-600',
    'bg-amber-500/20 text-amber-300 border-amber-500/30',
    'bg-blue-500/20 text-blue-300 border-blue-500/30',
    'bg-violet-500/20 text-violet-300 border-violet-500/30',
    'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
  ];
  const SRS_KEY  = 'hanyu-srs-v1';
  const ALL_ITEMS = JSON.parse(serialized);

  let srsData = {};
  let pendingLevelUps = []; // items acertados que el usuario puede subir manualmente

  function loadSRS()  { try { srsData = JSON.parse(localStorage.getItem(SRS_KEY)||'{}'); } catch { srsData={}; } }
  function saveSRS()  { localStorage.setItem(SRS_KEY, JSON.stringify(srsData)); }
  function getSRS(it) { return srsData[it.chinese] ?? { box:0, nextDate:'' }; }

  function updateSRS(item, correct) {
    const rec = getSRS(item);
    // Nunca subimos de nivel automáticamente: el usuario decide en el resumen
    const newBox = correct
      ? rec.box
      : (sessionSourceBox === 4 ? 3 : rec.box);
    const next = new Date(Date.now() + INTERVALS[newBox]*86400000).toISOString().slice(0,10);
    srsData[item.chinese] = { box:newBox, nextDate:next };
    saveSRS();
    // Registrar candidatos a subir (acertadas y que no estén ya en el máximo)
    if (correct && rec.box < 4 && !pendingLevelUps.includes(item)) {
      pendingLevelUps.push(item);
    }
  }

  function isDue(item) {
    const rec = getSRS(item);
    if (!rec.nextDate) return true;
    return rec.nextDate <= new Date().toISOString().slice(0,10);
  }

  // ── Session state ──────────────────────────────────────────────────────────
  let sessionItems     = [];
  let sessionIndex     = 0;
  let sessionResults   = [];  // [{item, correct, boxBefore, boxAfter}]
  let allFiltered      = [];  // full tema set for "practice all"
  let sessionSourceBox = null; // set when launched from a specific SRS box
  let direction      = 'zh-to-es';
  let activeDirection = 'random';
  let activeTema      = 'all';
  let phase           = 'answering';
  let pinyinOn        = false;
  let meaningOn       = false;

  const $  = id => document.getElementById(id);
  const promptEl       = $('prompt-text');
  const hintEl         = $('prompt-hint');
  const pinyinEl       = $('pinyin-text');
  const meaningEl      = $('meaning-text');
  const answerEl       = $('answer-input');
  const typeBadge      = $('type-badge');
  const srsBadge       = $('srs-badge');
  const extraBadge     = $('extra-badge');
  const resultBanner   = $('result-banner');
  const resultLine     = $('result-line');
  const correctAnswer  = $('correct-answer');
  const btnPinyin      = $('btn-pinyin');
  const btnMeaning     = $('btn-meaning');
  const btnCheck       = $('btn-check');
  const btnNext        = $('btn-next');
  const btnKnew        = $('btn-knew');
  const btnDidnt       = $('btn-didnt');
  const rowCheck       = $('row-check');
  const rowNext        = $('row-next');
  const rowSelfassess  = $('row-selfassess');
  const srsCounts      = $('srs-counts');
  const temaDesk       = $('tema-desk');
  const temaMob        = $('tema-mob');
  const settingsToggle = $('pc-settings-toggle');
  const settingsPanel  = $('pc-settings-panel');
  const pcCard         = $('pc-card');
  const sessionEndEl   = $('session-end');
  const sessionProgEl  = $('session-progress');

  // ── Settings panel (mobile) ────────────────────────────────────────────────
  let settingsOpen = false;
  settingsToggle.addEventListener('click', () => {
    settingsOpen = !settingsOpen;
    settingsPanel.style.maxHeight = settingsOpen ? '300px' : '0';
    settingsPanel.style.opacity   = settingsOpen ? '1'     : '0';
  });

  // ── Helpers ────────────────────────────────────────────────────────────────
  function shuffle(arr) {
    const a = [...arr];
    for (let i=a.length-1;i>0;i--) { const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
    return a;
  }

  function normalise(s) {
    return s.normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[1-5]/g,'')
      .toLowerCase().replace(/[.,!?¿¡；，。！？''…]/g,'').replace(/\s+/g,' ').trim();
  }

  function isCorrect(input, item) {
    const norm           = normalise(input);
    if (!norm) return false;
    const pinyinNorm     = normalise(item.pinyin);
    const pinyinNoSpaces = pinyinNorm.replace(/\s/g,'');
    const normNoSpaces   = norm.replace(/\s/g,'');
    if (direction === 'zh-to-es')
      return item.meaning.split(/[\/,]/).map(normalise).some(o => o === norm)
          || norm === pinyinNorm || normNoSpaces === pinyinNoSpaces;
    return normalise(item.chinese) === norm
        || norm === pinyinNorm
        || normNoSpaces === pinyinNoSpaces;
  }

  function setReveal(el, btn, v) { el.classList.toggle('invisible',!v); btn.classList.toggle('on',v); }
  function resetReveals() {
    pinyinOn = false; meaningOn = false;
    setReveal(pinyinEl, btnPinyin, false);
    setReveal(meaningEl, btnMeaning, false);
  }

  // ── SRS ────────────────────────────────────────────────────────────────────
  function renderSRSBadge(item) {
    const b = getSRS(item).box;
    srsBadge.className   = `text-xs font-medium px-2 py-0.5 rounded-full border ${BOX_CLASSES[b]}`;
    srsBadge.textContent = BOX_LABEL[b];
  }

  function renderSRSCounts() {
    srsCounts.innerHTML = '';
    for (let b=0;b<5;b++) {
      const group = ALL_ITEMS.filter(i=>(srsData[i.chinese]?.box??0)===b);
      const count = group.length;

      const wrapper = document.createElement('div');
      wrapper.className = 'flex flex-col';

      // Clickable header row
      const header = document.createElement('button');
      header.className = `rounded-lg px-3 py-1.5 border ${BOX_CLASSES[b]} flex items-center justify-between w-full cursor-pointer hover:opacity-80 transition-opacity`;
      header.innerHTML = `
        <span class="text-[10px] opacity-80">${BOX_LABEL[b]}</span>
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm">${count}</span>
          <span class="text-[10px] opacity-50 transition-transform duration-200 inline-block" data-arrow>▾</span>
        </div>`;

      // Expandable panel
      const panel = document.createElement('div');
      panel.className = 'overflow-hidden';
      panel.style.cssText = 'max-height:0;opacity:0;transition:max-height 0.25s ease,opacity 0.2s ease';

      const inner = document.createElement('div');
      inner.className = 'pt-2 pb-1 flex flex-col gap-2';

      if (count > 0) {
        const chips = document.createElement('div');
        chips.className = 'flex flex-wrap gap-1';
        chips.innerHTML = group.map(i =>
          `<span class="text-xs px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300"
            style="font-family:'PingFang SC','Noto Sans SC',sans-serif">${i.chinese}</span>`
        ).join('');
        inner.appendChild(chips);

        const studyBtn = document.createElement('button');
        studyBtn.className = 'w-full py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors';
        studyBtn.textContent = `Estudiar estas ${count} →`;
        studyBtn.addEventListener('click', e => { e.stopPropagation(); startSession(group, b); });
        inner.appendChild(studyBtn);
      } else {
        inner.innerHTML = `<p class="text-xs text-slate-500 text-center py-0.5">Ninguna todavía</p>`;
      }

      panel.appendChild(inner);
      wrapper.appendChild(header);
      wrapper.appendChild(panel);
      srsCounts.appendChild(wrapper);

      // Toggle
      let open = false;
      header.addEventListener('click', () => {
        open = !open;
        panel.style.maxHeight = open ? panel.scrollHeight + 'px' : '0';
        panel.style.opacity   = open ? '1' : '0';
        const arrow = header.querySelector('[data-arrow]');
        if (arrow) arrow.style.transform = open ? 'rotate(180deg)' : '';
      });
    }
  }

  // ── Progress bar ───────────────────────────────────────────────────────────
  function renderProgress() {
    const done    = sessionIndex;
    const total   = sessionItems.length;
    const correct = sessionResults.filter(r => r.correct).length;
    const pct     = total > 0 ? Math.round(done / total * 100) : 0;
    const acc     = done > 0  ? Math.round(correct / done * 100) : null;

    $('session-pos').textContent   = String(done);
    $('session-total').textContent = String(total);
    $('session-bar').style.width   = `${pct}%`;

    const accEl = $('session-accuracy-text');
    if (acc !== null) {
      accEl.textContent = `${acc}% ✓`;
      accEl.className   = `font-semibold text-xs ${acc>=80?'text-emerald-400':acc>=50?'text-amber-400':'text-rose-400'}`;
    } else {
      accEl.textContent = '';
    }
  }

  // ── Session end screen ─────────────────────────────────────────────────────
  function showSessionEnd() {
    pcCard.classList.add('hidden');
    sessionProgEl.classList.add('hidden');
    sessionEndEl.classList.remove('hidden');
    sessionEndEl.classList.add('flex');

    const total    = sessionResults.length;
    const correct  = sessionResults.filter(r => r.correct).length;
    const errors   = sessionResults.filter(r => !r.correct).map(r => r.item);
    const leveled  = pendingLevelUps;
    const accuracy = total > 0 ? Math.round(correct / total * 100) : 0;
    const noDue    = total === 0;

    $('session-end-emoji').textContent    = noDue ? '✨' : accuracy>=80 ? '🎉' : accuracy>=50 ? '💪' : '📚';
    $('session-end-title').textContent    = noDue ? '¡Todo al día!' : '¡Sesión completada!';
    $('session-end-subtitle').textContent = noDue
      ? 'No hay tarjetas pendientes. Usa "Practicar todas" para repasar.'
      : `${correct} de ${total} correctas`;

    const statsEl = $('session-stats');
    statsEl.innerHTML = '';
    if (!noDue) {
      const addStat = (label, value, cls) => {
        const div = document.createElement('div');
        div.className = 'rounded-xl p-3 bg-white/5 border border-white/10 text-center';
        div.innerHTML = `<div class="text-2xl font-bold ${cls}">${value}</div><div class="text-xs text-slate-400 mt-0.5">${label}</div>`;
        statsEl.appendChild(div);
      };
      const accCls = accuracy>=80?'text-emerald-400':accuracy>=50?'text-amber-400':'text-rose-400';
      addStat('Precisión', `${accuracy}%`,     accCls);
      addStat('Correctas', `${correct}`,        'text-emerald-400');
      addStat('Errores',   `${errors.length}`,  errors.length>0  ? 'text-rose-400'   : 'text-slate-300');
      addStat('↑ Nivel',   `${leveled.length}`, leveled.length>0 ? 'text-violet-400' : 'text-slate-300');
    }

    const leveledSec = $('session-leveled');
    if (leveled.length > 0) {
      leveledSec.classList.remove('hidden'); leveledSec.classList.add('flex');
      $('session-leveled-list').innerHTML = leveled.map(i =>
        `<span class="text-sm px-2 py-1 rounded-lg bg-violet-500/20 text-violet-300 border border-violet-500/30"
          style="font-family:'PingFang SC','Noto Sans SC',sans-serif">${i.chinese}</span>`
      ).join('');
    } else {
      leveledSec.classList.add('hidden'); leveledSec.classList.remove('flex');
    }

    const errorsSec = $('session-errors-section');
    const retryBtn  = $('btn-retry-errors');
    if (errors.length > 0) {
      errorsSec.classList.remove('hidden'); errorsSec.classList.add('flex');
      $('session-errors-list').innerHTML = errors.map(i =>
        `<span class="text-sm px-2 py-1 rounded-lg bg-rose-500/20 text-rose-300 border border-rose-500/30"
          style="font-family:'PingFang SC','Noto Sans SC',sans-serif">${i.chinese}</span>`
      ).join('');
      retryBtn.classList.remove('hidden');
    } else {
      errorsSec.classList.add('hidden'); errorsSec.classList.remove('flex');
      retryBtn.classList.add('hidden');
    }
  }

  // ── Start / restart session ────────────────────────────────────────────────
  function startSession(items, sourceBox = null) {
    sessionItems     = shuffle(items);
    sessionIndex     = 0;
    sessionResults   = [];
    pendingLevelUps  = [];
    sessionSourceBox = sourceBox;
    sessionEndEl.classList.add('hidden');
    sessionEndEl.classList.remove('flex');

    if (sessionItems.length === 0) {
      pcCard.classList.add('hidden');
      sessionProgEl.classList.add('hidden');
      showSessionEnd();
      return;
    }

    pcCard.classList.remove('hidden');
    sessionProgEl.classList.remove('hidden');
    renderProgress();
    renderCurrent();
  }

  function applyFilter(tema) {
    let base = ALL_ITEMS.slice();
    if (tema && tema !== 'all') base = base.filter(i => i.tags?.includes(tema));
    allFiltered = base;
    startSession(base.filter(isDue));
  }

  // ── Phase transitions ──────────────────────────────────────────────────────
  function goAnswering() {
    phase = 'answering';
    answerEl.disabled = false;
    answerEl.value    = '';
    resultBanner.classList.add('hidden');
    rowCheck.classList.remove('hidden');
    rowNext.classList.add('hidden');
    rowSelfassess.classList.add('hidden');
    answerEl.focus();
  }

  function goWordResult(correct, item) {
    phase = 'checked';
    answerEl.disabled = true;
    const boxBefore   = getSRS(item).box;
    updateSRS(item, correct);
    const boxAfter    = getSRS(item).box;
    sessionResults.push({ item, correct, boxBefore, boxAfter });
    renderSRSBadge(item);
    renderSRSCounts();
    resultBanner.classList.remove('hidden');
    const answerText = direction === 'zh-to-es'
      ? `${item.meaning}  —  ${item.pinyin}`
      : `${item.chinese}  /  ${item.pinyin}`;
    if (correct) {
      resultBanner.className    = 'rounded-xl px-4 py-3 text-sm text-center bg-emerald-500/10 border border-emerald-500/20';
      resultLine.className      = 'font-semibold text-emerald-400';
      resultLine.textContent    = '✓ Correcto';
      correctAnswer.textContent = answerText;
    } else {
      resultBanner.className    = 'rounded-xl px-4 py-3 text-sm text-center bg-rose-500/10 border border-rose-500/20';
      resultLine.className      = 'font-semibold text-rose-400';
      resultLine.textContent    = '✗ Incorrecto';
      correctAnswer.textContent = answerText;
    }
    rowCheck.classList.add('hidden');
    rowNext.classList.remove('hidden');
  }

  function goPhraseAssess() {
    phase = 'selfassess';
    answerEl.disabled = true;
    meaningOn = true;
    setReveal(meaningEl, btnMeaning, true);
    rowCheck.classList.add('hidden');
    rowSelfassess.classList.remove('hidden');
  }

  // ── Render current card ────────────────────────────────────────────────────
  const ZH_CLS = 'text-4xl font-medium text-white';
  const ES_CLS = 'text-2xl font-medium text-slate-200 leading-snug';

  function renderCurrent() {
    if (!sessionItems.length) return;
    const item   = sessionItems[sessionIndex];
    const isWord = item.type === 'word';

    typeBadge.textContent = isWord ? 'palabra' : 'frase';
    renderSRSBadge(item);
    extraBadge.classList.toggle('hidden', !item.extra);

    if (isWord) direction = activeDirection==='random' ? (Math.random()<.5?'zh-to-es':'es-to-zh') : activeDirection;
    else        direction = 'zh-to-es';

    if (direction === 'zh-to-es') {
      promptEl.className        = ZH_CLS;
      promptEl.style.fontFamily = "'PingFang SC','Noto Sans SC',sans-serif";
      promptEl.textContent      = item.chinese;
      hintEl.textContent        = isWord ? 'escribe el significado o pinyin' : '';
      answerEl.placeholder      = 'Escribe el significado en español…';
    } else {
      promptEl.className        = ES_CLS;
      promptEl.style.fontFamily = '';
      promptEl.textContent      = item.meaning;
      hintEl.textContent        = 'escribe en chino o pinyin';
      answerEl.placeholder      = 'Escribe en chino o en pinyin…';
    }

    pinyinEl.textContent  = item.pinyin;
    meaningEl.textContent = item.meaning;
    resetReveals();
    goAnswering();
  }

  function nextItem() {
    sessionIndex++;
    renderProgress();
    if (sessionIndex >= sessionItems.length) { showSessionEnd(); return; }
    renderCurrent();
  }

  // ── Events ─────────────────────────────────────────────────────────────────
  btnPinyin.addEventListener('click',  () => { pinyinOn  = !pinyinOn;  setReveal(pinyinEl,  btnPinyin,  pinyinOn); });
  btnMeaning.addEventListener('click', () => { meaningOn = !meaningOn; setReveal(meaningEl, btnMeaning, meaningOn); });

  btnCheck.addEventListener('click', () => {
    const item = sessionItems[sessionIndex];
    item.type === 'word' ? goWordResult(isCorrect(answerEl.value, item), item) : goPhraseAssess();
  });

  btnNext.addEventListener('click', nextItem);

  btnKnew.addEventListener('click', () => {
    const item      = sessionItems[sessionIndex];
    const boxBefore = getSRS(item).box;
    updateSRS(item, true);
    sessionResults.push({ item, correct:true, boxBefore, boxAfter:getSRS(item).box });
    renderSRSCounts();
    nextItem();
  });

  btnDidnt.addEventListener('click', () => {
    const item      = sessionItems[sessionIndex];
    const boxBefore = getSRS(item).box;
    updateSRS(item, false);
    sessionResults.push({ item, correct:false, boxBefore, boxAfter:getSRS(item).box });
    renderSRSCounts();
    nextItem();
  });

  // Session end buttons
  $('btn-retry-errors').addEventListener('click', () => {
    startSession(sessionResults.filter(r => !r.correct).map(r => r.item));
  });
  $('btn-new-session').addEventListener('click',  () => applyFilter(activeTema));
  $('btn-practice-all').addEventListener('click', () => startSession(allFiltered));

  // Tema selects
  function onTemaChange(val) {
    activeTema = val;
    if (temaDesk) temaDesk.value = val;
    if (temaMob)  temaMob.value  = val;
    applyFilter(val);
  }
  temaDesk?.addEventListener('change', e => onTemaChange(e.target.value));
  temaMob?.addEventListener('change',  e => onTemaChange(e.target.value));

  // Direction buttons
  document.querySelectorAll('.dir-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const dir = btn.dataset.dir;
      document.querySelectorAll('.dir-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll(`.dir-btn[data-dir="${dir}"]`).forEach(b => b.classList.add('active'));
      activeDirection = dir;
      if (!sessionEndEl.classList.contains('hidden')) return;
      renderCurrent();
    });
  });

  // Confirmar subida de nivel manual
  $('btn-confirm-levelup').addEventListener('click', () => {
    pendingLevelUps.forEach(item => {
      const rec = getSRS(item);
      const newBox = Math.min(rec.box + 1, 4);
      const next = new Date(Date.now() + INTERVALS[newBox]*86400000).toISOString().slice(0,10);
      srsData[item.chinese] = { box:newBox, nextDate:next };
    });
    saveSRS();
    renderSRSCounts();
    pendingLevelUps = [];
    $('session-leveled').classList.add('hidden');
    $('session-leveled').classList.remove('flex');
  });

  // Enter key
  document.addEventListener('keydown', e => {
    if (e.key !== 'Enter') return;
    if (e.target.tagName === 'SELECT') return;
    const tabContent = $('pc-root')?.closest('.tab-content');
    if (tabContent && !tabContent.classList.contains('active')) return;
    if (e.target===btnCheck || e.target===btnNext || e.target===btnKnew || e.target===btnDidnt) return;
    if (phase === 'answering') btnCheck.click();
    else if (phase === 'checked') btnNext.click();
  });

  // ── Init ───────────────────────────────────────────────────────────────────
  loadSRS();
  applyFilter('all');
  renderSRSCounts();
</script>
